{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1140px"
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#0d6efd", "name": "Primär (Bootstrap)" },
				{ "slug": "secondary", "color": "#6c757d", "name": "Sekundär" },
				{ "slug": "dark", "color": "#212529", "name": "Dunkel" },
				{ "slug": "light", "color": "#f8f9fa", "name": "Hell" },
				{ "slug": "white", "color": "#ffffff", "name": "Weiß" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ]
		},
		"typography": {
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Klein" },
				{ "slug": "medium", "size": "1rem", "name": "Mittel" },
				{ "slug": "large", "size": "1.25rem", "name": "Groß" },
				{ "slug": "x-large", "size": "1.5rem", "name": "Sehr groß" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--dark)"
		}
	}
}
